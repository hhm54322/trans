# API
APP_ENV=development
APP_DATABASE_PATH=./data/app.db
# Uploaded translation source files and diagnostic logs are private server data.
# Do not expose these directories through Nginx or a public download endpoint.
APP_UPLOAD_SOURCE_DIRECTORY=./data/uploads
APP_DOCUMENT_LOG_PATH=./data/logs/document-jobs.log
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_MAX_UPLOAD_MB=200
APP_MAX_DOCUMENT_CHARACTERS=1000000
APP_PORT=8000
APP_PDF_OCR_MAX_PAGES=50
APP_PDF_OCR_DESIRED_WIDTH=1600
APP_PDF_OCR_CONCURRENCY=2
# Auto translates the complete editable CAD text layer natively. For outlined
# text it uses local Tesseract Thai-script recall, routes reliable complete
# lines to the text model, and sends only uncertain crops to vision review.
# `paddle` is an explicit full-page geometry diagnostic, not the auto default.
APP_CAD_OCR_MODE=auto

# AI provider: demo | openai
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_API_MODE=auto
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_CONCURRENCY=10
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1.0
