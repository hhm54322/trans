# API
APP_ENV=development
APP_DATABASE_PATH=./data/app.db
# Uploaded translation source files and diagnostic logs are private server data.
# Do not expose these directories through Nginx or a public download endpoint.
APP_UPLOAD_SOURCE_DIRECTORY=./data/uploads
APP_DOCUMENT_LOG_PATH=./data/logs/document-jobs.log
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_MAX_UPLOAD_MB=200
APP_MAX_DOCUMENT_CHARACTERS=1000000
APP_PORT=8000
APP_PDF_OCR_MAX_PAGES=50
APP_PDF_OCR_DESIRED_WIDTH=1600
APP_PDF_OCR_CONCURRENCY=2
# Auto translates the complete editable CAD text layer natively. For outlined
# text it uses local Tesseract Thai-script recall, routes reliable complete
# lines to the text model, and sends only uncertain crops to vision review.
# `paddle` is an explicit full-page geometry diagnostic, not the auto default.
APP_CAD_OCR_MODE=auto
# 每张 CAD 索引图保持原分辨率。实测 3 图比 2 图请求更少、长尾更低，
# 识别率不降；4 图容易进入长尾。异常时仍会自动回退单图。
APP_CAD_INDEXED_IMAGES_PER_REQUEST=3
# 高清复核图每张仅 3 行，4 图合并后仍只有 12 行；异常时会自动退回单图。
APP_CAD_REVIEW_IMAGES_PER_REQUEST=4
# 视觉请求和 CAD 页的并发上限应根据生产网关压测调整。
APP_CAD_INDEXED_MODEL_CONCURRENCY=5
APP_CAD_VISUAL_PAGE_CONCURRENCY=4
# Paddle 漏检复核每个工作线会常驻一套模型。auto 会按容器实际 CPU/内存
# 在 1–2 路间选择；也可显式填写 1–4，但需自行确保内存余量。
APP_CAD_PADDLE_WORKERS=auto
# Paddle 推理后端配置。生产 CentOS 默认关闭 MKL-DNN 以避免已知兼容问题；
# 有 GPU 时可设 APP_PADDLE_DEVICE=gpu:0。auto 会按容器可见 CPU 为 Paddle 和
# Tesseract 分配互不挤占的线程预算，也可显式填写正整数覆盖。
APP_PADDLE_DEVICE=
APP_PADDLE_CPU_THREADS=auto
APP_PADDLE_ENABLE_MKLDNN=false
# Docker 镜像预置并用独立数据卷持久化这两个模型；容器重建不会再次下载。
# 同一 CAD 视觉请求超过此秒数时启动一次延迟对冲；设为 0 可关闭
APP_CAD_INDEXED_HEDGE_DELAY_SECONDS=25
APP_CAD_INDEXED_HEDGE_CONCURRENCY=1
# 结构化文本请求超过此秒数时排队启动对冲；正常请求优先，设为 0 可关闭。
APP_TEXT_MODEL_HEDGE_DELAY_SECONDS=60

# AI provider: demo | openai
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_API_MODE=auto
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_CONCURRENCY=10
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1.0
